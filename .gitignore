# ===============
# Rust/Cargo
# ===============

# Cargo output directory
/target/

# If you're developing a library, you might want to commit Cargo.lock.
# Uncomment the following line if you want to ignore it:
# Cargo.lock

# ===============
# Build Artifacts & Temporary Files
# ===============

# Backup files generated by Rust (if any)
**/*.rs.bk

# ===============
# Exclude CSV Files
# ===============
# Ignore all CSV files (modify the pattern if you want to be more selective)
*.csv

# ===============
# IDEs, Editors, and OS Files
# ===============

# Common editor directories and files
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS generated files
.DS_Store
Thumbs.db

# Swap files (common for vim, etc.)
*.swp
*.swo

